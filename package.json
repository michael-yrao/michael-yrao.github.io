{
  "name": "progressive-overflow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "check:groundedness": "vitest run --config vitest.groundedness.config.ts",
    "check:contract-mirror": "node scripts/check-contract-mirror.mjs",
    "gen:registry": "node scripts/gen-registry.mjs",
    "check:registry": "node scripts/gen-registry.mjs --check",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "check:sitemap": "node scripts/gen-sitemap.mjs --check"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "highlight.js": "^11.12.0",
    "peerjs": "^1.5.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "angular-cli-ghpages": "^1.0.7",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
